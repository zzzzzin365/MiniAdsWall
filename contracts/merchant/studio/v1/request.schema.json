{
  "Brief": {
    "type": "object",
    "properties": {
      "brand_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,100}$"
      },
      "subject_type": {
        "enum": [
          "product",
          "service",
          "store",
          "event",
          "undecided"
        ]
      },
      "subject_description": {
        "type": "string",
        "maxLength": 4000
      },
      "objective": {
        "enum": [
          "awareness",
          "traffic",
          "leads",
          "appointments",
          "sales",
          "undecided"
        ]
      },
      "idea": {
        "type": "string",
        "maxLength": 4000
      },
      "confirmed_facts": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "string",
          "maxLength": 500
        }
      },
      "asset_refs": {
        "type": "array",
        "maxItems": 5,
        "items": {
          "type": "object",
          "properties": {
            "asset_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,100}$"
            },
            "role": {
              "enum": [
                "subject_photo",
                "existing_ad",
                "style_reference"
              ]
            }
          },
          "required": [
            "asset_id",
            "role"
          ],
          "additionalProperties": false
        }
      },
      "bid_basis": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "contribution_minor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000
          },
          "purchase_probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "ad_share": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "channel",
          "contribution_minor",
          "purchase_probability",
          "ad_share"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "brand_id",
      "subject_type",
      "subject_description",
      "objective",
      "idea",
      "confirmed_facts",
      "asset_refs"
    ],
    "additionalProperties": false
  },
  "Revision": {
    "type": "object",
    "properties": {
      "expected_revision": {
        "type": "integer",
        "minimum": 1
      },
      "brief": {
        "type": "object",
