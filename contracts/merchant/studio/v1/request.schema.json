          "subject_type": {
            "enum": [
              "product",
              "service",
              "store",
              "event",
              "undecided"
            ]
          },
          "subject_description": {
            "type": "string",
            "maxLength": 4000
          },
          "objective": {
            "enum": [
              "awareness",
              "traffic",
              "leads",
              "appointments",
              "sales",
              "undecided"
            ]
          },
          "idea": {
            "type": "string",
            "maxLength": 4000
          },
          "confirmed_facts": {
            "type": "array",
