                "asset_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,100}$"
                },
                "role": {
                  "enum": [
                    "subject_photo",
                    "existing_ad",
                    "style_reference"
                  ]
                }
              },
              "required": [
                "asset_id",
                "role"
              ],
              "additionalProperties": false
            }
          },
          "bid_basis": {
            "type": "object",
            "properties": {
              "channel": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "contribution_minor": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000000
              },
              "purchase_probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "ad_share": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "channel",
              "contribution_minor",
              "purchase_probability",
              "ad_share"
            ],
            "additionalProperties": false
          }
