# MiniAdsWall Agent 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_NAME=MiniAdsWall Agent
MARKETING_PROTOCOL_VERSION=1
MARKETING_ENVIRONMENT=synthetic
# S1 resource + serve + event/source ingestion; migrate:marketing up first.
MARKETING_EVENTS_ENABLED=false
MARKETING_CONTENT_ENABLED=false
MARKETING_AGENT_ACTIONS_ENABLED=false
MARKETING_DELIVERY_ENABLED=false
MARKETING_LEARNING_ENABLED=false
# At least 32 bytes. Shared by Koa instances; changing it invalidates existing tokens.
MARKETING_SIGNING_KEY=
# Source credentials are distinct from operator credentials; keep real tokens outside Git.
# {"shop":{"token":"<at-least-24-characters>","environment":"synthetic","brand_ids":["brand_a"],"interfaces":["conversions","spend-entries","spend-coverage"]}}
MARKETING_SOURCES={}
# Used only by the local synthetic seed CLI.
MARKETING_SEED_SOURCE_TOKEN=
# CP04 independent worker: dedicated MySQL credential, no ads/raw-write grants.
# Does not fall back to ADS_MYSQL_URL or hosting DATABASE_URL.
MARKETING_WORKER_MYSQL_URL=
# Optional Unix socket for a local MySQL instance.
MARKETING_WORKER_MYSQL_SOCKET=
APP_ENV=production
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 本地 OpenRouter 免费模式：填写 Key 后运行
# .venv/bin/python scripts/run_local_agent.py
# 启动器将 Agent 与创意生成统一路由到免费模型，不需要 Anthropic Key。
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free

# 可选：覆盖为兼容 Anthropic 协议的第三方 API（如 DeepSeek）
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 可选：覆盖模型名称（默认 claude-3-5-sonnet-20241022）
# 使用 DeepSeek 时设为 deepseek-chat
# ANTHROPIC_MODEL=deepseek-chat

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=miniadswall123

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
ANOMALY_DETECTION_THRESHOLD=2.0

# ── 评测 ──────────────────────────────────────────────────────────────────────
EVAL_BASELINE_PATH=./data/eval/baseline.json

# ── Skills ───────────────────────────────────────────────────────────────────
# 默认读取项目内 ./skills，支持运行时通过 POST /skills/reload 热加载
ECHOMIND_SKILLS_DIR=./skills
ECHOMIND_SKILLS_MAX_PROMPT_CHARS=5000

# ── 安全 ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_in_production
JWT_SECRET_KEY=change_this_in_production

# 四态决策状态 TTL
CONFIRMATION_TTL_SECONDS=300
CLARIFICATION_TTL_SECONDS=600

# 服务端用户权限映射。默认空对象时，删除广告、删除素材和修改预算/出价都会被拒绝。
# 权限不会从 /chat 请求体读取，生产环境还必须由认证层保证 user_id 不可伪造。
ACTION_PERMISSION_MAP={}
# 本地演示高风险确认流程时可使用：
# ACTION_PERMISSION_MAP={"mini-ad-manager":["ads.delete","ads.asset.delete","ads.budget.write"]}

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── 功能开关 ──────────────────────────────────────────────────────────────────
ENABLE_SWAGGER_UI=true
ENABLE_MONITORING=true
ENABLE_EVALUATION=true

# Koa 业务边界（空凭据默认拒绝运营操作；不要使用同一值）
ADS_OPERATOR_TOKEN=
# Koa 和 FastAPI 设置相同的内部服务凭据，不发给浏览器
AGENT_SERVICE_TOKEN=
ADS_AGENT_API_URL=http://localhost:8000
MAX_AD_BID=100
# 广告业务必须连接 MySQL 8.4；所有 Koa 实例使用同一数据库。
# 与托管数据库共享时沿用相同账号；密码中的特殊字符必须做 URL 编码。
ADS_MYSQL_URL=mysql://agent:change-me@127.0.0.1:3306/miniadswall
# 可选：使用 Unix socket，覆盖 TCP 连接。
# ADS_MYSQL_SOCKET=/absolute/path/to/mysql.sock
# 多宿主上传需要共享目录；广告 JSON 只用于迁移，不再是运行时存储。
# ADS_UPLOAD_DIR=/absolute/path/to/shared/uploads
# 原 ADS_DATA_FILE 请作为 migrate-ads.js --source 参数传入。

# 创意/策略模型配置：现在由 FastAPI 读取
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/devstral-2512:free
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# 模型实际调用并发：local 为单进程；多实例共享额度必须用 redis
MODEL_GATE_MODE=local
MODEL_GATE_NAMESPACE=shared-provider
MODEL_MAX_CONCURRENCY=4
MODEL_MAX_QUEUE=32
MODEL_QUEUE_WAIT_SECONDS=5
MODEL_EXECUTION_SECONDS=45

# 仅独立规则问答参与语义缓存；启用时必须配置 Embedding 服务
FAQ_CACHE_ENABLED=false
FAQ_CACHE_THRESHOLD=0.95
FAQ_CACHE_TTL_SECONDS=3600
FAQ_KNOWLEDGE_VERSION=v1
# OpenAI-compatible embeddings endpoint, configured explicitly; no default provider
FAQ_EMBEDDING_URL=
FAQ_EMBEDDING_API_KEY=
FAQ_EMBEDDING_MODEL=
# 默认使用 config/cacheable_faq.json；修改规则时更新文件和知识版本
# FAQ_CATALOG_PATH=/absolute/path/to/cacheable_faq.json

# Durable Agent hosting. A shared object mount is allowed for one-host development;
# configure S3 for a multi-host deployment. Secrets are separate from model credentials.
AGENT_HOSTING_URL=http://127.0.0.1:8002
DATABASE_URL=mysql+pymysql://agent:change-me@127.0.0.1:3306/miniadswall?charset=utf8mb4
HOSTING_DB_PASSWORD=
HOSTING_DB_ROOT_PASSWORD=
HOSTING_CURSOR_SECRET=
HOSTING_OBJECT_DIR=data/hosting-objects
HOSTING_S3_BUCKET=
HOSTING_S3_ENDPOINT=
HOSTING_EXECUTOR_URL=
HOSTING_EXECUTOR_TOKEN=
HOSTING_SANDBOX_IMAGE=miniadswall-sandbox:1
# 广告运营助手默认检索共享营销知识库；false 仅用于回滚/对照。
HOSTING_RAG_ENABLED=true
HOSTING_RAG_EVIDENCE_TIMEOUT_SECONDS=16
# 检索后证据检查：默认开启；false 仅用于对照评测/紧急回滚。
RAG_EVIDENCE_ENABLED=true
# 临时起点，模型评分不等于校准概率，阈值需要更多固定问题评测。
RAG_EVIDENCE_THRESHOLD=0.7
# 两次检查共用的总时限，不改变 /chat 的 28 秒请求上限。
RAG_EVIDENCE_TIMEOUT_SECONDS=8
# 工作台素材 RAG：沿用 Chroma 文本向量，对图片描述和视频抽样帧描述检索。
# 此值为余弦相似度下限，不是回答正确率；需根据自己的素材集评测。
STUDIO_MEDIA_RAG_MIN_SCORE=0.25
# 本机沿用嵌入式 Chroma；多实例部署时显式改为 server，使用 CHROMA_HOST/PORT。
STUDIO_MEDIA_RAG_STORAGE=local
# CP02: explicit versions and staged release guards. Upgrade schemas before starting readers.
BACKEND_DEPLOYMENT_MODE=development
HOSTING_INPUT_PROTOCOL_VERSION=1
HOSTING_EXECUTOR_PROTOCOL_VERSION=1
# Context reader exists; keep the writer off until every Worker is compatible and old runs drain.
AD_CONTEXT_V1_ENABLED=false
# These four capabilities are not implemented yet; true currently fails startup.
SHARED_ASSET_WRITES_ENABLED=false
NARROW_TRANSACTIONS_ENABLED=false
SSE_SHARED_READER_ENABLED=false
DYNAMIC_EXECUTOR_ENABLED=false
# Optional multi-user gateway credential map: {"alice":"secret-a","bob":"secret-b"}
ADS_OPERATOR_TOKENS={}

# 广告属性召回：先执行 migrate:ads 和 migrate:recall，再启动独立 recall 进程。
# Koa 与 recall 使用同一个数据库和内部凭据；开关控制新筛选入口。
ADS_RECALL_ENABLED=false
ADS_RECALL_URL=http://127.0.0.1:3010
ADS_RECALL_TOKEN=
ADS_RECALL_HOST=127.0.0.1
ADS_RECALL_PORT=3010
# 每个运行实例使用唯一、稳定的消费者 ID；同一 ID 的租约不允许并行启动。
ADS_RECALL_CONSUMER_ID=local-recall
ADS_RECALL_SNAPSHOT_DIR=recall-snapshots
ADS_RECALL_REBUILD=false
# 首次安装可提供字段目录 JSON；重复迁移保持相同目录，不能在线改字段语义。
ADS_RECALL_FIELDS_FILE=
# outbox 总预算 16 GiB，按 32 分区分配；单分区超过 90% 时写入回滚。
ADS_RECALL_OUTBOX_MAX_BYTES=17179869184
# 分页游标签名密钥；不填时由运营凭据派生，凭据轮换会使旧游标失效。
ADS_CURSOR_SECRET=

# Qwen / 百炼北京按量付费；填写 Key 后优先用于聊天、生成和 Worker
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-flash-2026-07-15

# 火山方舟北京 Seed；填写 Key 后优先于 Qwen，或设置 LLM_PROVIDER=seed
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-1-lite-260915

# 独立视频模型，与 Seed 文本模型分开
SEEDANCE_MODEL=doubao-seedance-1-0-pro-fast-251015

# 商家营销创意工作台（迁移独立登记019；先完成营销013）
MERCHANT_WORKSPACE_ENABLED=false
STUDIO_VIDEO_ENABLED=false
# 路由固定，禁止fallback；实际模型ID不允许浏览器覆盖
STUDIO_DEFAULT_MODEL=deepseek-v4-1-flash-260910
STUDIO_MEDIA_MODEL=doubao-seedance-1-0-pro-fast-251015
STUDIO_ROUTING_POLICY=seed-understanding-v2
# Koa 与 studio Worker 必须共用私有存储目录（不得置于公开 uploads 下）
# STUDIO_STORAGE_DIR=/absolute/path/to/studio-private
STUDIO_FFPROBE=ffprobe
# 图片首帧需要供应商能读取的HTTPS服务地址；无配置仍可文生视频
STUDIO_PUBLIC_BASE_URL=
STUDIO_ASSET_SIGNING_KEY=
STUDIO_PROVIDER_ASSET_HOSTS=volces.com,volcengine.com,byteimg.com

# 上传图片/视频后自动进行Seed理解，视频抽样帧由ffmpeg本地提取
STUDIO_UNDERSTANDING_MODEL=doubao-seed-2-0-mini-260428
STUDIO_FFMPEG=ffmpeg

# Memory schema v3: run python -m hosting.migrate up before restarting hosting.
# Keep off until isolation/retraction checks pass; shadow reads do not affect answers.
AGENT_MEMORY_READ_ENABLED=false
AGENT_MEMORY_WRITE_ENABLED=false
AGENT_MEMORY_SHADOW_ENABLED=true
AGENT_EXPERIENCE_READ_ENABLED=false
AGENT_MEMORY_TOKEN_BUDGET=3200
AGENT_MEMORY_READ_TIMEOUT_MS=800
# Conservative UTF-8 byte estimate; reserve output tokens separately at provider level.
AGENT_MODEL_INPUT_TOKEN_BUDGET=64000
# Compatibility /chat submits and waits for the SAME durable run. It requires a hosted
# numeric conv_id, X-Agent-Session, service auth and Idempotency-Key. No body user_id trust.
AGENT_SYNC_DURABLE_ENABLED=false
AGENT_SYNC_WAIT_SECONDS=20
# Empty means all authenticated subjects; comma-separated names enable a scoped rollout.
AGENT_MEMORY_SUBJECTS=
# Add memory.review_procedure only to the intended reviewer's existing ACTION_PERMISSION_MAP.

# Text RAG v2: publish an isolated generation before enabling either entrypoint.
RAG_V2_ENABLED=false
RAG_V2_SHADOW_ENABLED=false
# Default: <CHROMA_PERSIST_DIRECTORY>/rag-text-v2.sqlite3. Share this path across API/Worker.
# RAG_V2_STORE=/absolute/path/to/rag-text-v2.sqlite3
RAG_V2_HYBRID_ENABLED=true
RAG_V2_REWRITE_ENABLED=true
RAG_V2_PARENT_ENABLED=false
RAG_V2_RERANKER=llm
# dedicated requires an explicitly provisioned local scalar cross-encoder (no downloads).
# RAG_V2_RERANK_MODEL_PATH=/absolute/path/to/local-model
RAG_V2_CITATIONS_ENABLED=false
